# Public site URL used for absolute links and docs (no secrets).
# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: label shown on the health-check page
NEXT_PUBLIC_APP_ENV=development

# Server-only Google Gemini key for the Listing Assistant (/api/chat).
# Get one at https://aistudio.google.com/apikey — never prefix with NEXT_PUBLIC_.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model override (default: gemini-flash-latest). gemini-2.0-flash and
# gemini-2.5-flash are retired / closed to new keys.
# GOOGLE_GENERATIVE_MODEL=gemini-3.8-flash
